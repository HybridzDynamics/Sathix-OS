generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Scheme {
  id        String   @id
  url       String   @unique
  title     String?
  summary   String?
  content   String?
  source    String?
  attachments Json?
  meta      Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
