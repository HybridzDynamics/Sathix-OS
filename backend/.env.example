# ── Backend ──────────────────────────────────────────────────
PORT=5000

# PostgreSQL (shared with scraper-engine)
DATABASE_URL=postgresql://user:password@localhost:5432/sathix?sslmode=require

# Auth
JWT_SECRET=change_me_in_production

# Redis (optional — for future session caching)
REDIS_URL=redis://127.0.0.1:6379

# RAG service internal URL
RAG_ENGINE_URL=http://localhost:3001

# Internal service auth token (shared with rag-service)
INTERNAL_SERVICE_TOKEN=change_me_shared_secret

# RAG call timeout in milliseconds
RAG_TIMEOUT_MS=15000

# Internal service health probes used only by the Backend admin overview.
LANGUAGE_ENGINE_URL=http://localhost:4001
VOICE_SERVICE_URL=http://localhost:4002

# One-time privileged account bootstrap. Supply values in your local .env, never source control.
SUPER_ADMIN_MOBILE=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=SathiX Super Admin
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_ALLOW_UPDATE=false

# External AI key (future — not used by RAG engine)
AI_API_KEY=
