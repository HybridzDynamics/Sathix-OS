generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CITIZEN
  ADMIN
  SUPER_ADMIN
  PARTNER
}

enum SchemeStatus {
  ACTIVE
  DISABLED
  ARCHIVED
}

enum SchemeOrigin {
  SCRAPED
  ADMIN_MODIFIED
}

enum ScraperJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  REJECTED
}

enum Language {
  ENGLISH
  HINDI
  OTHER
}

model User {
  id            String           @id @default(cuid())
  name          String
  mobile        String           @unique
  email         String?          @unique
  passwordHash  String
  role          Role             @default(CITIZEN)
  isActive      Boolean          @default(true)
  lastActiveAt  DateTime?
  language      Language         @default(ENGLISH)
  profile       CitizenProfile?
  applications  Application[]
  chatSessions  ChatSession[]
  notifications Notification[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model CitizenProfile {
  id            String   @id @default(cuid())
  user          User     @relation(fields: [userId], references: [id])
  userId        String   @unique
  age           Int?
  gender        String?
  state         String?
  district      String?
  occupation    String?
  income        String?
  education     String?
  category      String?
  disability    String?
  familyDetails String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model Scheme {
  id               String          @id @default(cuid())
  name             String
  description      String
  department       String?
  category         String?
  state            String?
  eligibility      String?
  benefits         String?
  documentsRequired String?
  applicationLink  String?
  sourceUrl        String?
  status           SchemeStatus    @default(ACTIVE)
  origin           SchemeOrigin    @default(SCRAPED)
  contentHash      String?
  lastScrapedAt    DateTime?
  indexedAt        DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  applications     Application[]
  documents        SchemeDocument[]
}

model SchemeSource {
  id        String   @id @default(cuid())
  url       String
  title     String?
  state     String?
  createdAt DateTime @default(now())
}

model SchemeCategory {
  id        String   @id @default(cuid())
  name      String   @unique
  createdAt DateTime @default(now())
}

model SchemeDocument {
  id        String   @id @default(cuid())
  scheme    Scheme   @relation(fields: [schemeId], references: [id])
  schemeId  String
  name      String
  required  Boolean  @default(true)
}

model Application {
  id            String            @id @default(cuid())
  user          User              @relation(fields: [userId], references: [id])
  userId        String
  scheme        Scheme            @relation(fields: [schemeId], references: [id])
  schemeId      String
  status        ApplicationStatus @default(DRAFT)
  submittedDate DateTime?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
}

model ChatSession {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id])
  userId    String
  messages  ChatMessage[]
  createdAt DateTime      @default(now())
}

model ChatMessage {
  id         String      @id @default(cuid())
  session    ChatSession @relation(fields: [sessionId], references: [id])
  sessionId  String
  role       String
  content    String
  createdAt  DateTime    @default(now())
}

model ScraperLog {
  id        String   @id @default(cuid())
  sourceUrl String
  status    String
  meta      String?
  createdAt DateTime @default(now())
}

model ScraperJob {
  id                 String            @id @default(cuid())
  queueJobId         String?           @unique
  sourceUrl          String
  sourceName         String?
  status             ScraperJobStatus  @default(QUEUED)
  startedAt          DateTime?
  completedAt        DateTime?
  pagesProcessed     Int               @default(0)
  pagesFailed        Int               @default(0)
  schemesDiscovered  Int               @default(0)
  newSchemes         Int?
  updatedSchemes     Int?
  failedItems        Int               @default(0)
  error              String?
  retryCount         Int               @default(0)
  triggeredBy        String?
  requestId          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model Notification {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  title     String
  body      String
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  entity    String
  entityId  String?
  details   String?
  createdAt DateTime @default(now())
}
