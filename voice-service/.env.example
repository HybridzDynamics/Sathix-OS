PORT=4002
HOST=0.0.0.0

# Shared service-to-service token. Leave empty only for local development.
INTERNAL_SERVICE_TOKEN=change_me_shared_secret
LANGUAGE_ENGINE_URL=http://localhost:4001
BACKEND_URL=http://localhost:5000
REQUEST_TIMEOUT_MS=15000

# Audio safeguards, implemented in Phase 3.
MAX_AUDIO_BYTES=10485760
MAX_AUDIO_DURATION_MS=120000
ALLOWED_AUDIO_MIME_TYPES=audio/wav,audio/x-wav,audio/mpeg,audio/ogg,audio/webm,audio/mp4,audio/aac
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW_MS=60000

# Provider/model selection. Paths belong in model registry entries, never in application code.
STT_PROVIDER=python-http
TTS_PROVIDER=python-http
VAD_PROVIDER=unconfigured
ACTIVE_STT_MODEL=
ACTIVE_TTS_MODEL=

# Local STT inference API, introduced in Phase 4. This is not exposed publicly.
STT_INFERENCE_URL=http://127.0.0.1:8002
STT_MODEL_PATH=
STT_DEVICE=auto
STT_COMPUTE_TYPE=int8

# Local TTS inference API. Select only an approved, license-compatible voice artifact.
TTS_INFERENCE_URL=http://127.0.0.1:8003
TTS_MODEL_PATH=
TTS_DEVICE=auto
TTS_COMPUTE_TYPE=int8
MAX_TTS_TEXT_LENGTH=5000
MAX_RESPONSE_AUDIO_BYTES=5242880

# Low-bandwidth mode uses shorter uploads and defaults /voice/query to text-only output.
LOW_BANDWIDTH_MAX_AUDIO_BYTES=2097152
LOW_BANDWIDTH_MAX_AUDIO_DURATION_MS=30000
LOW_BANDWIDTH_MAX_BITRATE=128000
