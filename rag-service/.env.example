# ── RAG Service ───────────────────────────────────────────────
PORT=3001

# PostgreSQL (shared with backend)
DATABASE_URL=postgresql://user:password@localhost:5432/sathix?sslmode=require

# Qdrant
QDRANT_URL=https://your-qdrant-cluster.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key

# Vector store: 'qdrant' for production/docker, 'memory' for bare local dev
VECTOR_STORE=qdrant

# Embedding provider: 'local' (Docker/dev hash vectors) | 'none' (noop zeros) | 'openai' | 'hf'
EMBEDDING_PROVIDER=local
EMBEDDING_API_KEY=
EMBEDDING_DIM=384

# Answer generator: 'noop' | 'openai'
ANSWER_GENERATOR=noop

# Language detection
LANGUAGE_DETECTOR=simple

# Worker settings
WORKER_CONCURRENCY=2
EMBEDDING_POLL_INTERVAL_MS=15000

# Internal auth token (must match INTERNAL_SERVICE_TOKEN in backend)
INTERNAL_SERVICE_TOKEN=change_me_shared_secret
