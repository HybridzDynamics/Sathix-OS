# ── SathiX-OS Docker Compose (root) ──────────────────────────
# Copy to .env and adjust before: docker compose up --build

# PostgreSQL
POSTGRES_USER=sathix
POSTGRES_PASSWORD=change_me_local_dev_password
POSTGRES_DB=sathix
POSTGRES_PORT=5432

# Redis
REDIS_PORT=6379

# Qdrant
QDRANT_PORT=6333
VECTOR_STORE=memory

# Backend
BACKEND_PORT=5000
JWT_SECRET=change_me_to_a_long_random_secret
INTERNAL_SERVICE_TOKEN=change_me_shared_internal_token
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# RAG
RAG_PORT=3001
EMBEDDING_PROVIDER=none
ANSWER_GENERATOR=noop

# Scraper
SCRAPER_WORKER_CONCURRENCY=2

# Optional service ports (profiles: language, voice, whatsapp)
LANGUAGE_PORT=4001
LANGUAGE_ML_PORT=8001
VOICE_PORT=4002
STT_PORT=8002
TTS_PORT=8003
WHATSAPP_PORT=4003

# WhatsApp (Meta Cloud API — required only with --profile whatsapp)
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# Super admin bootstrap (backend only — set in backend/.env for non-Docker dev)
SUPER_ADMIN_MOBILE=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=SathiX Super Admin
SUPER_ADMIN_EMAIL=
