# ── SathiX-OS Docker Compose (root) ──────────────────────────
# Copy to .env and adjust before: docker compose up --build

# PostgreSQL
POSTGRES_USER=sathix
POSTGRES_PASSWORD=change_me_local_dev_password
POSTGRES_DB=sathix
POSTGRES_PORT=5432
DATABASE_URL=postgresql://sathix:change_me_local_dev_password@localhost:5432/sathix

# Redis / Qdrant
REDIS_PORT=6379
QDRANT_PORT=6333

# Shared secrets (must match across all services)
JWT_SECRET=change_me_to_a_long_random_secret
INTERNAL_SERVICE_TOKEN=change_me_shared_internal_token

# Backend
BACKEND_PORT=5000
BACKEND_URL=http://localhost:5000
WHATSAPP_SERVICE_URL=http://whatsapp-service:4003
RAG_ENGINE_URL=http://rag-service:3001
LANGUAGE_ENGINE_URL=http://language-engine:4001
VOICE_SERVICE_URL=http://voice-service:4002
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3100,http://localhost:5173

# RAG — Qdrant + local deterministic embeddings (no API key required)
RAG_PORT=3001
QDRANT_URL=http://localhost:6333
VECTOR_STORE=qdrant
EMBEDDING_PROVIDER=local
EMBEDDING_DIM=384
ANSWER_GENERATOR=noop

# Scraper
SCRAPER_WORKER_CONCURRENCY=2

# Language Engine
LANGUAGE_PORT=4001
LANGUAGE_ML_PORT=8001

# Voice — download models first: bash scripts/download-voice-models.sh
VOICE_MODEL_DIR=./runtime-models
VOICE_PORT=4002
STT_PORT=8002
TTS_PORT=8003
STT_MODEL_PATH=/models/faster-whisper-small
TTS_MODEL_PATH=/models/piper-en-us-lessac.onnx
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_PROVIDER=python-http
TTS_PROVIDER=python-http

# WhatsApp — set WHATSAPP_DEV_MODE=false and fill Meta credentials for production
WHATSAPP_PORT=4003
WHATSAPP_DEV_MODE=true
WHATSAPP_VERIFY_TOKEN=dev_verify_token_change_me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_PHONE_NUMBER_ID=

# Frontends (browser must reach backend on host, not Docker internal DNS)
ADMIN_PANEL_PORT=3100
USER_PANEL_PORT=3000
NEXT_PUBLIC_BACKEND_URL=http://localhost:5000
VITE_BACKEND_URL=http://localhost:5000

# Super admin bootstrap (backend)
SUPER_ADMIN_MOBILE=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=SathiX Super Admin
SUPER_ADMIN_EMAIL=
