# ── SathiX Language Engine Environment Variables ─────────────
PORT=4001
HOST=0.0.0.0

# Python ML Inference Service URL
PYTHON_ML_SERVICE_URL=http://127.0.0.1:8001
PYTHON_ML_SERVICE_PORT=8001

# Model & Provider Configuration
TRANSLATION_PROVIDER=indictrans2
DETECTION_PROVIDER=fasttext
TRANSLITERATION_PROVIDER=indic_transliteration
EMBEDDING_PROVIDER=sentence_transformers
SUMMARIZATION_PROVIDER=indic_bart

# Service Security & Auth
INTERNAL_SERVICE_TOKEN=change_me_shared_internal_token
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Backend Integration
BACKEND_URL=http://localhost:5000
RAG_ENGINE_URL=http://localhost:3001
